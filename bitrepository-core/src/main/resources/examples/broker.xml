<!--
  Reference Apache ActiveMQ Artemis broker configuration (broker.xml).

  This is the Artemis counterpart of the ActiveMQ Classic activemq.xml. Bitrepository does not ship a
  Classic activemq.xml (the broker is provisioned outside this repository), so this file is the from-scratch
  expression of the application's message-routing needs, written against repository conventions:

    * <CollectionDestination> (e.g. topic://dummy-repository-id)      -> <address> with <multicast>
    * <AlarmDestination>       (e.g. topic://dummy-repository-id.alarms) -> <address> with <multicast> (durable)
    * <ReceiverDestinationID>/<ContributorDestinationID> (topic://...) -> <address> with <multicast>

  Every destination is a topic (pub/sub), as under ActiveMQ Classic. The component-private destinations
  (<ReceiverDestinationID>/<ContributorDestinationID>) inherit the topic:// scheme of the collection destination
  in DefaultReceiverDestinationIDFactory / UserSpecificReceiverDestinationIDFactory and are passed to
  Session.createTopic(...). Each normally has a single subscriber, but that is a convention the broker does not
  enforce. Their names are dynamic (<collection>-<componentID>[-contributor]), so they are NOT declared
  statically here; the broker auto-creates the MULTICAST address when the client first subscribes.

  Because these destination names are dynamic, auto-create must stay enabled (see the global <address-setting>
  matching "#"). Do not disable it, or every <collection>/<componentID> combination would have to be enumerated here.

  Adjust at a minimum before production use:
    * acceptor addresses/ports, and TLS (see the commented tls acceptor matching the example RepositorySettings URL)
    * <security-settings> - this file is deliberately permissive; tighten to your authenticators/roles
    * persistence and broker <name>
-->
<configuration xmlns="urn:activemq" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
               xsi:schemaLocation="urn:activemq /schema/artemis-configuration.xsd">

    <core xmlns="urn:activemq:core">

        <name>bitmagasin-broker</name>

        <!-- Persist messages across broker restarts. Disable for ephemeral/test brokers only. -->
        <persistence-enabled>true</persistence-enabled>
        <journal-type>ASYNCIO</journal-type>

        <acceptors>
            <acceptor name="core">tcp://0.0.0.0:12345?protocols=CORE;tcpSendBufferSize=1048576;tcpReceiveBufferSize=1048576</acceptor>

            <!-- In-VM, used by embedded/test brokers. -->
            <acceptor name="invm">vm://0?protocols=CORE</acceptor>

            <!-- TLS acceptor matching the example secure MessageBusConfiguration URL (ssl://messagebus:61601).
                 Uncomment the two lines in to enable TLS. -->
            <!-- <acceptor name="core-ssl">ssl://0.0.0.0:61601?protocols=CORE;keyStorePath=/etc/broker/broker.keystore;keyStorePassword=${KEYSTORE_PASSWORD}</acceptor> -->
        </acceptors>

        <security-settings>
            <security-setting match="#">
                <permission type="createNonDurableQueue" roles="amq"/>
                <permission type="deleteNonDurableQueue" roles="amq"/>
                <permission type="createDurableQueue" roles="amq"/>
                <permission type="deleteDurableQueue" roles="amq"/>
                <permission type="createAddress" roles="amq"/>
                <permission type="deleteAddress" roles="amq"/>
                <permission type="consume" roles="amq"/>
                <permission type="send" roles="amq"/>
                <permission type="manage" roles="amq"/>
            </security-setting>
        </security-settings>

        <address-settings>
            <!--
              Single global block. AUTO-CREATE IS REQUIRED: the private receiver/contributor topics and the
              per-subscriber queues under every multicast address are created on demand - see heading comment.
              Dead-letter: unmatched/expired messages are shipped to DLQ/DLQ-expiry for manual inspection, and a
              failed alarm ends up there rather than vanishing.

              Memory is bounded per address (PAGE spills to disk instead of dropping, so nothing is lost) so a
              single loaded collection/pillar cannot exhaust broker heap and starve others. The limits live here
              rather than in a family-specific match because the dynamic destination names are
              <collection>-<componentID>[-contributor]: Artemis wildcards only match whole '.'-delimited words,
              so a pattern such as "dummy-repository-id#" matches only that exact name, never the dash-suffixed
              private destinations.
            -->
            <address-setting match="#">
                <dead-letter-address>DLQ</dead-letter-address>
                <expiry-address>ExpiryQueue</expiry-address>
                <max-delivery-attempts>5</max-delivery-attempts>
                <redelivery-delay>0</redelivery-delay>
                <auto-create-addresses>true</auto-create-addresses>
                <auto-delete-addresses>false</auto-delete-addresses>
                <auto-create-queues>true</auto-create-queues>
                <auto-delete-queues>false</auto-delete-queues>
                <max-size-bytes>104857600</max-size-bytes>
                <page-size-bytes>1048576</page-size-bytes>
                <address-full-policy>PAGE</address-full-policy>
            </address-setting>
        </address-settings>

        <!--
          Statically declared multicast (pub/sub) addresses. The component-private receiver/contributor topics are
          intentionally not listed here: they are dynamic per component and auto-created as MULTICAST by the clients.
        -->
        <addresses>
            <!-- <CollectionDestination> - broadcast of Identify* requests to all pillars of the collection. -->
            <address name="dummy-repository-id">
                <multicast/>
            </address>

            <!-- <AlarmDestination> - durable broadcast of alarms to the alarm service(s). -->
            <address name="dummy-repository-id.alarms">
                <multicast/>
            </address>
        </addresses>

    </core>
</configuration>