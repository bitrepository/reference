  <profiles>
    <profile>
      <id>deploy</id>
      <build>
        <plugins>
          <plugin>
            <artifactId>maven-source-plugin</artifactId>
            <executions>
              <execution>
                <id>attach-sources</id>
                <goals>
                  <goal>jar</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <artifactId>maven-javadoc-plugin</artifactId>
            <executions>
              <execution>
                <id>attach-javadocs</id>
                <goals>
                  <goal>jar</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
    <profile>
      <id>skip-unit-tests</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-surefire-plugin</artifactId>
            <configuration>
              <skipTests>true</skipTests>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>

  <properties>
    <!-- Specify java version here, to support forbiddenapis plugin -->
    <maven.compiler.release>21</maven.compiler.release>
    <api.check.phase>process-classes</api.check.phase>
    <message.xml.version>33</message.xml.version>
    <repository.settings.version>15</repository.settings.version>
    <jaxb.version>4.0.12</jaxb.version>
    <project.site.location>dav:https://sbforge.org/maven/bitrepository/sites/reference/${project.version}
    </project.site.location>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>
